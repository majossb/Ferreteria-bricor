# ==============================================================================
# BRICOR BACKEND - VARIABLES DE ENTORNO
# ==============================================================================
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# SQLite
DB_PATH=./server/data/bricor.sqlite

# ==============================================================================
# WOMPI COLOMBIA SANDBOX
# ==============================================================================
# Llave PÚBLICA (puede compartirse con el cliente para el Widget)
WOMPI_PUBLIC_KEY=pub_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Llave PRIVADA (ESTRICTAMENTE PRIVADA - Para consultas server-to-server)
WOMPI_PRIVATE_KEY=prv_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Secreto de INTEGRIDAD (ESTRICTAMENTE PRIVADO - Exclusivo para firmar SHA-256)
# https://docs.wompi.co/docs/colombia/firma-de-integridad
WOMPI_INTEGRITY_SECRET=test_integrity_xxxxxxxxxxxxxxxxxxxxxxxx

# Secreto de EVENTOS / WEBHOOKS (ESTRICTAMENTE PRIVADO - Para validar X-Event-Checksum)
# https://docs.wompi.co/docs/colombia/eventos
WOMPI_EVENTS_SECRET=test_events_xxxxxxxxxxxxxxxxxxxxxxxx

# Ambiente y URL base de Wompi API
WOMPI_ENV=sandbox
WOMPI_API_URL=https://sandbox.wompi.co/v1
