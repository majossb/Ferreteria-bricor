{
  "name": "bricor-ferreteria",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "server": "node server/index.js",
    "server:dev": "node --watch server/index.js",
    "dev:all": "concurrently -n \"SERVER,CLIENT\" -c \"bgBlue.bold,bgMagenta.bold\" \"pnpm run server\" \"pnpm run dev\"",
    "test:backend": "node server/test/backend.test.js",
    "test:http": "node server/test/http.test.js",
    "test:lifecycle": "node server/test/wompi_and_lifecycle.test.js",
    "test": "node server/test/backend.test.js && node server/test/http.test.js && node server/test/wompi_and_lifecycle.test.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "gsap": "^3.15.1",
    "lucide-react": "^1.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "uikit": "^3.23.11"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.7",
    "oxlint": "^1.88.0",
    "pngjs": "^7.0.0",
    "vite": "^8.3.4"
  }
}
